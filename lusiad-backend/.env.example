# Preferido: ~/.lusiad/config.json, compartilhado com frontend e runner.
# Overrides opcionais. JVM -Dlusiad.db.* > ambiente > .env local > JSON.
# LUSIAD_CONFIG_FILE=D:/configuracoes/lusiad.json
# LUSIAD_ENV_FILE=D:/configuracoes/plugin.env
# LUSIAD_API_URL=http://127.0.0.1:8765
# LUSIAD_DB_HOST=127.0.0.1
# LUSIAD_DB_PORT=3306
# LUSIAD_DB_NAME=lusiad
# LUSIAD_DB_USER=seu_usuario
# LUSIAD_DB_PASSWORD=
# LUSIAD_DB_TLS=false
# LUSIAD_DB_CONNECT_TIMEOUT_MS=5000
# LUSIAD_DB_SOCKET_TIMEOUT_MS=30000
