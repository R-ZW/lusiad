# Opcional. O padrão compartilhado é ~/.lusiad/config.json.
# Use caminho absoluto. Nunca use NEXT_PUBLIC_ para estes valores.
# LUSIAD_CONFIG_FILE=D:/configuracoes/lusiad.json
# LUSIAD_API_URL=http://127.0.0.1:8765
# LUSIAD_FRONTEND_URL=http://localhost:3000
# Aceita HTTPS nos endereços aleatórios *.trycloudflare.com, preservando acesso local.
# LUSIAD_ALLOW_CLOUDFLARE_TUNNEL=false
# LUSIAD_TEMP_ROOT=D:/lusiad/temp
# LUSIAD_DB_HOST=127.0.0.1
# LUSIAD_DB_PORT=3306
# LUSIAD_DB_NAME=lusiad
# LUSIAD_DB_USER=seu_usuario
# LUSIAD_DB_PASSWORD=
# LUSIAD_DB_TLS=false
# LUSIAD_ANALYTICS_ENABLED=false
# LUSIAD_DB_CONNECT_TIMEOUT_MS=5000
# LUSIAD_API_TIMEOUT_MS=0
