  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "node scripts/start-next.mjs dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node scripts/start-next.mjs start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit --incremental false",
    "lint": "node node_modules/eslint/bin/eslint.js src tests --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "test:tags:db": "node scripts/test-history-tags.mjs",
    "test:git:db": "node scripts/test-git-recording.mjs",
    "verify": "node node_modules/typescript/bin/tsc --noEmit --incremental false && node node_modules/eslint/bin/eslint.js src tests --max-warnings=0 && node --experimental-strip-types --test tests/**/*.test.ts && node node_modules/next/dist/bin/next build",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  },
